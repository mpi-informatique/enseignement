---
import '../styles/global.css';
interface Props { title?: string }
const { title = 'Banque d’exercices · Enseignement MPI' } = Astro.props;
---
<!doctype html>
<html lang="fr" data-theme="enseignement">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Rechercher, éditer et compiler les exercices et devoirs Typst de la banque publique MPI : énoncés, corrigés et PDF." />
    <link rel="icon" type="image/png" sizes="1254x1254" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <title>{title}</title>
    <script is:inline>
      try {
        const theme = localStorage.getItem('enseignement:theme');
        document.documentElement.dataset.theme = (theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches) ? 'enseignement-dark' : 'enseignement';
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au document</a>
    <slot />
    <noscript>Activer JavaScript pour rechercher et compiler les exercices dans le navigateur. Les sources restent disponibles sur <a href="https://github.com/mpi-informatique/exercices">GitHub</a>.</noscript>
  </body>
</html>
