{
  "name": "enseignement-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:data": "python3 scripts/prepare.py && node scripts/assets.mjs",
    "dev": "npm run prepare:data && astro dev --host 127.0.0.1",
    "build": "npm run prepare:data && astro check && astro build",
    "check": "astro check",
    "test": "node --experimental-strip-types --test test/*.test.ts && python3 -m unittest discover -s test -p 'test_*.py'",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@mpi-informatique/enseignement-core": "file:../shared",
    "@myriaddreamin/typst-ts-web-compiler": "0.8.0-rc3",
    "@myriaddreamin/typst.ts": "0.8.0-rc3",
    "astro": "7.3.8",
    "codemirror": "6.0.2",
    "codemirror-lang-typst": "0.6.0",
    "lucide-react": "1.55.0",
    "minisearch": "7.2.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "daisyui": "5.7.47",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
